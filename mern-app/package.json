{
  "name": "devverse-mern",
  "version": "1.0.0",
  "description": "DevVerse — Unified Developer Ecosystem (Full-Stack MERN Rebuild)",
  "scripts": {
    "install:server": "npm --prefix server install",
    "install:client": "npm --prefix client install",
    "install-all": "npm run install:server && npm run install:client",
    "server": "npm --prefix server start",
    "dev:server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently \"npm --prefix server run dev\" \"npm --prefix client run dev\"",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:client",
    "seed": "npm --prefix server run seed",
    "test:server": "npm --prefix server test",
    "test": "npm run test:server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
